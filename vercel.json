{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run web:build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/((?!(?:mcp|app|api|bon|factuur|oauth|k|\\.well-known)(?:/|$)).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/prijzen",
      "destination": "https://boekiehouder.nl/#prijzen",
      "permanent": true
    },
    {
      "source": "/boekie-pro",
      "destination": "https://boekiehouder.nl/#prijzen",
      "permanent": true
    },
    {
      "source": "/goedkoop-boekhoudprogramma-zzp",
      "destination": "https://boekiehouder.nl/#prijzen",
      "permanent": true
    },
    {
      "source": "/beste-boekhoudprogramma-zzp",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/kennisbank/kleineondernemersregeling-kor",
      "destination": "https://boekiehouder.nl/belastingregels-2026/#kor_omzetgrens",
      "permanent": true
    },
    {
      "source": "/kennisbank",
      "destination": "https://boekiehouder.nl/belastingregels-2026/",
      "permanent": true
    },
    {
      "source": "/kennisbank/:path*",
      "destination": "https://boekiehouder.nl/belastingregels-2026/",
      "permanent": true
    },
    {
      "source": "/hoe-het-werkt",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/voor-wie",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/boekhouden-naast-baan",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/zzp-naast-loondienst-btw",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/over-ons",
      "destination": "https://boekiehouder.nl/",
      "permanent": true
    },
    {
      "source": "/moneybird-alternatief",
      "destination": "https://boekiehouder.nl/overstappen/moneybird/",
      "permanent": true
    },
    {
      "source": "/:brand(jortt|e-boekhouden|financible)-alternatief",
      "destination": "https://boekiehouder.nl/overstappen/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.boekiehouder.nl"
        }
      ],
      "destination": "https://boekiehouder.nl/:path*",
      "permanent": true
    }
  ],
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "rules/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/api"
    },
    {
      "source": "/app/:path*",
      "destination": "/api"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/k/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
