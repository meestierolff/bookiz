# Copy to .env for docker compose. None of these are needed for local stdio use.

# Required for the HTTP server. Generate with: openssl rand -hex 24
BOOKIZ_TOKEN=

# Optional. Enables https://your-server/mcp/<this> for assistants that only accept a URL
# (claude.ai, ChatGPT, Grok). Must differ from BOOKIZ_TOKEN. Leave empty to keep that door shut.
BOOKIZ_URL_TOKEN=

# Public https address of this server; enables receipt-upload and invoice links.
PUBLIC_URL=

# Leave empty to use the embedded database in the data volume.
DATABASE_URL=

# E-mail (optional): send invoices and archive receipts to your own mailbox.
# Brevo example: smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=

# "email" or "folder". Default: email when SMTP_URL is set.
RECEIPT_ARCHIVE=
