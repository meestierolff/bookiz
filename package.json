{
  "name": "bookiz",
  "version": "0.1.0",
  "description": "Open-source bookkeeping for Dutch sole proprietors with few invoices, driven by your own AI agent over MCP.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "start:http": "node src/cli.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "rules:check": "node scripts/check-rules.ts",
    "web:build": "node web/build.ts",
    "verify": "npm run typecheck && npm run rules:check && npm test && npm run web:build && npm run site:check",
    "site:check": "node scripts/check-site.ts",
    "seo:indexnow": "node scripts/indexnow.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "read-excel-file": "9.3.12",
    "typescript": "^7.0.2"
  }
}
